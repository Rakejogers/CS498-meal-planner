# Copy to .env.local, or run `npm run env:local` to fill these from the local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:58321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Kroger API (https://developer.kroger.com). Register the redirect URI in the Kroger app
# exactly as written here; production uses https://<your-domain>/api/kroger/callback.
KROGER_CLIENT_ID=""
KROGER_CLIENT_SECRET=""
KROGER_REDIRECT_URI="http://localhost:3000/api/kroger/callback"
