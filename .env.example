# Copy to .env.local, or run `npm run env:local` to fill these from the local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:58321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Vercel AI Gateway key, used to plan meals (lib/ai/). `npm run env:local` keeps it.
AI_GATEWAY_API_KEY=""

# Kroger API (https://developer.kroger.com). Register the redirect URI in the Kroger app
# exactly as written here; production uses https://<your-domain>/api/kroger/callback.
KROGER_CLIENT_ID=""
KROGER_CLIENT_SECRET=""
KROGER_REDIRECT_URI="http://localhost:3000/api/kroger/callback"

# Dev only. Comma-separated hostnames (no scheme or port) allowed to use the dev server,
# e.g. a VPS IP you open from your own machine. localhost always works.
DEV_ORIGINS=""

# Optional, for Sign in with Google locally. These go in supabase/.env, not .env.local (see README).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""
