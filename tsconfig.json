{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".yarn",
    "docs",
    "public",
    ".agents",
    ".codex",
    ".vscode",
    ".husky/_",
    "supabase/.temp",
    "supabase/.branches",
    "out",
    "build",
    "dist",
    ".cache",
    ".turbo",
    ".vercel",
    "coverage",
    "playwright-report",
    "test-results",
    "blob-report",
    "playwright/.cache"
  ]
}
